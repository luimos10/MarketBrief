# ═══════════════════════════════════════════════════════
# MARKET BRIEF — VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════
#
# 1. Copia este archivo a .env
# 2. Completa solo los valores que vayas a usar
# 3. No subas .env al repositorio
#

# ── PROVEEDOR DE IA ───────────────────────────────────
# Opciones: gemini | groq
AI_MODEL=gemini

# Google Gemini (obligatoria si AI_MODEL=gemini)
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-2.5-flash

# Groq (obligatoria si AI_MODEL=groq)
GROQ_API_KEY=tu-api-key-de-groq
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Tokens máximos de salida del briefing
# Gemini 2.5 Flash soporta ~65K, pero ahora desactivamos su thinking interno
# (modules/brief_generator.py) para que todo el budget vaya a la respuesta.
# 16000 alcanza con margen para el template v1.3 compacto (~5-7K tokens).
MAX_TOKENS=16000

# Límite efectivo para Groq (el script hace clamp automático al techo del modelo)
GROQ_MAX_TOKENS=8192

# ── DATOS DE MERCADO ──────────────────────────────────
# CoinMarketCap es opcional pero recomendado para enriquecer el contexto crypto
CMC_API_KEY=tu-api-key-de-coinmarketcap

# Financial Modeling Prep — calendario macro high-impact (opcional)
# Free tier: 250 req/día — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=tu-api-key-de-fmp

# CryptoPanic — news crypto scored (opcional, Fase 3)
CRYPTOPANIC_API_KEY=tu-api-key-de-cryptopanic

# Finnhub — news macro/equity (opcional, Fase 3)
FINNHUB_API_KEY=tu-api-key-de-finnhub

# FRED — Federal Reserve Economic Data (opcional, Fase 4 — recomendado)
# Free key en https://fred.stlouisfed.org/docs/api/api_key.html (registro 1 min)
# Habilita: curva yield 10Y-2Y, RRP balance, TGA balance, Fed funds rate
FRED_API_KEY=tu-api-key-de-fred

# Versión del prompt para tracking de alpha (cambia al modificar template)
PROMPT_VERSION=v1.4

# A/B testing: alterna aleatoriamente entre prompt_template.txt (v1) y
# prompt_template_v2.txt (v2). El logbook registra qué versión generó cada call,
# lo que permite comparar hit rates con: python evaluate_calls.py --by-version
PROMPT_AB_ENABLED=false

# ── ENTREGA ───────────────────────────────────────────
# Opciones: html | telegram | both
DELIVERY_METHOD=html

# Telegram solo es obligatorio si usas DELIVERY_METHOD=telegram/both
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
